# MongoDB Atlas
MONGODB_URI=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private administration (protects /admin and /api/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
ADMIN_WHATSAPP_NUMBER=2347065342818

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Object storage (add when file delivery is enabled)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# AI provider
AI_API_KEY=
# OpenAI-compatible base URL, for example https://openrouter.ai/api/v1
AI_BASE_URL=
# Provider model ID, for example openai/gpt-4.1-mini
AI_MODEL=

# Publishing intelligence provider fallback chain (all optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Mabrig Researcher Pro
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Responsible scholarly API identification
CROSSREF_MAILTO=
OPENALEX_API_KEY=

# Scholar Integrity Engine — optional real semantic retrieval
# Create an Atlas Vector Search index named scholar_integrity_vectors over
# CorpusSource.embedding using the same dimensions as the selected model.
HF_TOKEN=
# HUGGINGFACE_API_KEY= can be used instead of HF_TOKEN.
INTEGRITY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTEGRITY_EMBEDDING_DIMENSIONS=384
INTEGRITY_VECTOR_INDEX=scholar_integrity_vectors
# Override only when using a compatible Hugging Face inference endpoint/router.
HF_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models
